@import "./method-tabs.wxss";
.systems-page .form-card {
  padding: 28rpx;
  margin-top: 28rpx;
  overflow: visible;
}
.systems-page .form-field + .form-field {
  margin-top: 28rpx;
}
.systems-page .form-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.systems-page .optional {
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 400;
}
.systems-page .form-input,
.systems-page .picker-value {
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  padding: 22rpx;
  background: var(--soft);
  border-radius: 14rpx;
  color: var(--text);
  font-size: 28rpx;
  line-height: 48rpx;
}
.systems-page .question-input {
  width: 100%;
  min-height: 150rpx;
  height: 150rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--soft);
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.systems-page .form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.systems-page .lunar-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 12rpx;
}
.systems-page .form-grid > view,
.systems-page .lunar-grid > view {
  min-width: 0;
}
.systems-page .form-submit,
.systems-page .retry-save {
  width: 100%;
  margin: 28rpx 0 0;
}
.systems-page .system-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.systems-page .system-choice {
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 18rpx 10rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: var(--soft);
  color: var(--muted);
}
.systems-page .system-choice.active {
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}
.systems-page .date-switch {
  margin-bottom: 16rpx;
}
.systems-page .switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 50px;
  font-size: 27rpx;
}
.systems-page .switch-label {
  flex: 1;
}
.systems-page .profile-consent {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}
.systems-page .delete-profile {
  width: 100%;
  color: #985044;
  margin: 12rpx 0 0;
}
.systems-page .details-toggle {
  width: 100%;
  margin: 18rpx 0;
  justify-content: flex-start;
  padding: 0;
}
.systems-page .reading-result {
  padding-top: 8rpx;
}
.systems-page .result-state {
  color: var(--accent);
  font-size: 24rpx;
  margin-bottom: 18rpx;
}
.systems-page .result-title {
  font-size: 38rpx;
  line-height: 1.4;
  word-break: break-all;
}
.systems-page .reading-question {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--soft);
  border-radius: 16rpx;
  white-space: pre-wrap;
}
.systems-page .reading-summary {
  margin-top: 28rpx;
  padding: 26rpx;
  background: var(--accent-soft);
  border-radius: 18rpx;
  font-size: 29rpx;
  line-height: 1.8;
}
.systems-page .reading-section {
  margin-top: 30rpx;
}
.systems-page .reading-section .section-title {
  font-size: 29rpx;
}
.systems-page .reading-details {
  padding: 4rpx 24rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
}
.systems-page .detail-item {
  padding: 22rpx 0;
  word-break: break-all;
}
.systems-page .detail-item + .detail-item {
  border-top: 1rpx solid var(--border);
}
.systems-page .reading-rules {
  margin-top: 24rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.8;
}
.systems-page .reading-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.systems-page .reading-actions button,
.poster-actions .poster-action,
.review-note-actions button {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
}
.systems-page .reading-disclaimer {
  text-align: center;
  margin-top: 28rpx;
  font-size: 22rpx;
}
.systems-page .hexagram-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}
.systems-page .hexagram-mini {
  min-width: 0;
  padding: 20rpx 10rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}
.systems-page .hexagram-lines {
  width: 94rpx;
  margin: 20rpx auto;
}
.systems-page .hexagram-line {
  display: flex;
  justify-content: space-between;
  height: 10rpx;
  margin: 8rpx 0;
}
.systems-page .hexagram-line view {
  width: 43%;
  background: var(--text);
}
.systems-page .hexagram-line .yang-half {
  width: 57%;
}
.systems-page .hexagram-line.moving view {
  background: var(--accent);
}
.systems-page .hexagram-name {
  font-size: 25rpx;
  font-weight: 600;
}
.systems-page .tarot-result-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}
.systems-page .tarot-result-grid.single {
  grid-template-columns: 1fr;
  max-width: 330rpx;
  margin-left: auto;
  margin-right: auto;
}
.systems-page .tarot-result-card {
  min-width: 0;
  text-align: center;
}
.systems-page .tarot-image {
  width: 100%;
  height: 310rpx;
  display: block;
  margin: 16rpx 0;
  border-radius: 8rpx;
}
.systems-page .single .tarot-image {
  height: 480rpx;
}
.systems-page .tarot-image.reversed {
  transform: rotate(180deg);
}
.systems-page .tarot-name {
  font-size: 26rpx;
  font-weight: 600;
}
.systems-page .tarot-flip {
  width: 100%;
  min-width: 0;
  padding: 12rpx;
  margin: 0;
  border: 1rpx solid var(--border);
  background: #fff;
  border-radius: 14rpx;
}
.systems-page .tarot-back {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 14rpx 0;
  background: #675349;
  color: #fff5e7;
  border: 4rpx double #d8c7b5;
  border-radius: 8rpx;
  font-size: 48rpx;
  box-sizing: border-box;
}
.systems-page .single .tarot-back {
  height: 480rpx;
}
.systems-page .natal-card {
  padding: 22rpx;
  margin-top: 26rpx;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
}
.systems-page .pillar-grid {
  display: flex;
  gap: 12rpx;
}
.systems-page .pillar {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.systems-page .pillar-god {
  color: var(--accent);
  font-size: 24rpx;
  margin: 12rpx 0;
}
.systems-page .pillar-character {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
}
.systems-page .elements-row {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
  font-size: 26rpx;
}
.systems-page .elements-row text {
  color: var(--accent);
  font-weight: 600;
}
.systems-page .cycle-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.systems-page .palace-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-template-rows: repeat(4, minmax(158rpx, auto));
  gap: 5rpx;
  margin-top: 28rpx;
}
.systems-page .palace-cell {
  min-width: 0;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}
.systems-page .palace-name {
  color: var(--accent);
  font-size: 23rpx;
  font-weight: 600;
}
.systems-page .palace-stars {
  font-size: 23rpx;
  line-height: 1.5;
  margin: 8rpx 0;
  word-break: break-all;
}
.systems-page .palace-branch {
  font-size: 21rpx;
  color: var(--muted);
}
.systems-page .life-palace {
  background: var(--accent-soft);
  border-color: #cfb6a9;
}
.systems-page .palace-center {
  grid-row: 2 / 4;
  grid-column: 2 / 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 24rpx;
}
.systems-page .star-detail {
  color: var(--accent);
  font-size: 26rpx;
  margin-top: 14rpx;
}
