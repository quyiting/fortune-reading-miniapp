@import "../../styles/method-tabs.wxss";
.selector-card,
.detail-bridge,
.oracle-card,
.calendar-card,
.formal-card,
.relation-card,
.pattern-card,
.timing-card,
.timeline-card,
.yong-card,
.hidden-card,
.plate-card,
.moving-card,
.checklist-card,
.advice-card,
.followup-card {
  padding: 28rpx;
}

.selector-card {
  background: var(--surface);
}

.casting-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--surface);
  border: 1rpx solid rgba(168, 79, 44, 0.15);
}

.casting-head,
.knowledge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.casting-count,
.knowledge-order {
  color: var(--muted);
  font-size: 24rpx;
  flex-shrink: 0;
}

.coin-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  gap: 24rpx;
  margin: 16rpx 0;
}

.cast-coin {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 4rpx double #a16b36;
  border-radius: 50%;
  color: var(--muted);
  font-size: 28rpx;
  background: #ebcf9f;
}

.coin-back {
  background: var(--soft);
}

.casting-wait {
  color: var(--muted);
  font-size: 24rpx;
}

.casting-line-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 52rpx;
}

.casting-position,
.casting-type {
  color: var(--muted);
  font-size: 24rpx;
}

.casting-position {
  width: 60rpx;
}

.casting-type {
  width: 110rpx;
  text-align: right;
}

.casting-line-row .hex-line-box {
  margin: 0;
  flex-shrink: 0;
  animation: reveal-line 200ms ease-out;
}

.casting-placeholder {
  width: 134rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e7dccb;
}

.quick-insight-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-left: 4rpx solid var(--accent);
  border-radius: 0 20rpx 20rpx 0;
  background: var(--soft);
}

.knowledge-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.knowledge-title {
  margin-top: 12rpx;
  color: var(--text);
  font-size: 32rpx;
  font-weight: 700;
}

.knowledge-body {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(145, 92, 52, 0.12);
}

.knowledge-classic {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.9;
}

.knowledge-plain-label {
  margin-top: 24rpx;
}

@keyframes reveal-line {
  from {
    opacity: 0;
    transform: translateY(6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.selector-card,
.oracle-card,
.calendar-card,
.formal-card,
.relation-card,
.pattern-card,
.timing-card,
.timeline-card,
.yong-card,
.hidden-card,
.plate-card,
.moving-card,
.checklist-grid,
.advice-card,
.followup-card {
  margin-top: 24rpx;
}

.calendar-grid,
.formal-grid,
.checklist-grid {
  display: flex;
  gap: 18rpx;
}

.calendar-grid,
.formal-grid,
.checklist-grid {
  flex-direction: column;
}

.quick-result-card {
  margin-top: 0;
  padding: 28rpx;
  background: var(--surface);
}

.quick-result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.quick-result-copy {
  flex: 1;
}

.quick-voice {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.7;
  color: var(--text);
}

.quick-grid {
  margin-top: 22rpx;
}

.quick-value {
  font-size: 30rpx;
  line-height: 1.4;
}

.oracle-card {
  background: var(--surface);
}

.oracle-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.oracle-copy {
  flex: 1;
}

.result-title,
.visual-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.result-meta-top,
.moving-prompt {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.result-question {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--soft);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.decision-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.oracle-visuals {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
}

.visual-panel {
  flex: 1;
  min-width: 0;
  padding: 24rpx 18rpx;
  border-radius: 16rpx;
  background: var(--soft);
}

.visual-label {
  font-size: 24rpx;
  color: var(--muted);
}

.visual-divider {
  color: var(--muted);
  font-size: 34rpx;
  font-weight: 700;
}

.hex-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
}

.hex-line-box {
  position: relative;
  width: 132rpx;
  height: 14rpx;
  border-radius: 999rpx;
}

.hex-line-box.yang {
  background: linear-gradient(90deg, #5c371f 0%, #8d552d 100%);
}

.hex-line-box.yin::before,
.hex-line-box.yin::after {
  content: "";
  position: absolute;
  top: 0;
  width: 54rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5c371f 0%, #8d552d 100%);
}

.hex-line-box.yin::before {
  left: 0;
}

.hex-line-box.yin::after {
  right: 0;
}

.hex-line-box.moving {
  box-shadow: 0 0 0 6rpx rgba(193, 129, 62, 0.12);
}

.hex-line-box.changed {
  box-shadow: inset 0 0 0 2rpx rgba(255, 250, 242, 0.75), 0 0 0 6rpx rgba(182, 109, 53, 0.08);
}

.visual-title {
  margin-top: 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.calendar-box,
.formal-box {
  padding: 24rpx 24rpx;
  border-radius: 16rpx;
  background: var(--soft);
}

.formal-label {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
}

.formal-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.formal-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.yong-list {
  margin-top: 20rpx;
}

.yong-item + .yong-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(136, 92, 59, 0.1);
}

.yong-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yong-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.yong-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.yong-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--muted);
}

.plate-card {
  overflow: hidden;
}

.plate-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.plate-table {
  min-width: 1540rpx;
}

.plate-header,
.plate-row {
  display: flex;
  align-items: center;
}

.plate-header {
  padding: 0 0 18rpx;
  border-bottom: 1rpx solid rgba(136, 92, 59, 0.12);
  font-size: 24rpx;
  color: var(--muted);
}

.plate-row {
  min-height: 116rpx;
  padding: 18rpx 0;
}

.plate-row + .plate-row {
  border-top: 1rpx solid rgba(136, 92, 59, 0.08);
}

.plate-col {
  box-sizing: border-box;
  padding-right: 18rpx;
}

.spirit-col {
  width: 170rpx;
}

.najia-col {
  width: 170rpx;
}

.relation-col {
  width: 170rpx;
}

.hidden-col {
  width: 220rpx;
}

.state-col {
  width: 180rpx;
}

.line-col {
  width: 170rpx;
}

.role-col {
  width: 120rpx;
  text-align: center;
}

.changed-col {
  width: 240rpx;
}

.spirit-name,
.relation-name,
.hidden-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--muted);
}

.spirit-pos,
.relation-element,
.line-caption {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.state-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 68rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.state-pill.strong {
  background: rgba(176, 102, 55, 0.14);
  color: var(--muted);
}

.state-pill.mid {
  background: rgba(140, 106, 82, 0.12);
  color: var(--muted);
}

.state-pill.weak {
  background: rgba(120, 85, 70, 0.08);
  color: var(--muted);
}

.plate-line {
  width: 100%;
  height: 16rpx;
  border-radius: 999rpx;
}

.plate-line.yang {
  background: linear-gradient(90deg, #5c371f 0%, #8d552d 100%);
}

.plate-line.yin {
  background: linear-gradient(90deg, #5c371f 0 38%, transparent 38% 62%, #8d552d 62% 100%);
}

.plate-line.moving {
  box-shadow: 0 0 0 6rpx rgba(193, 129, 62, 0.12);
}

.plate-line.changed {
  box-shadow: inset 0 0 0 2rpx rgba(255, 250, 242, 0.75), 0 0 0 6rpx rgba(182, 109, 53, 0.08);
}

.role-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(198, 136, 69, 0.12);
  color: var(--muted);
  font-size: 24rpx;
}

.role-badge.active {
  background: var(--accent);
  color: #fff8f1;
}

.moving-list {
  margin-top: 18rpx;
}

.moving-item + .moving-item {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(136, 92, 59, 0.1);
}

.moving-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.moving-body {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--muted);
}

.timeline-list {
  margin-top: 18rpx;
}

.timeline-item {
  display: flex;
  gap: 18rpx;
}

.timeline-item + .timeline-item {
  margin-top: 18rpx;
}

.timeline-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 28rpx;
  flex-shrink: 0;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #c68845;
}

.timeline-dot.near {
  background: #a84f2c;
}

.timeline-dot.far {
  background: #c79a54;
}

.timeline-line {
  width: 2rpx;
  flex: 1;
  margin-top: 8rpx;
  background: rgba(168, 79, 44, 0.18);
}

.timeline-card-box {
  flex: 1;
  min-width: 0;
  padding: 22rpx 22rpx;
  border-radius: 22rpx;
  background: var(--soft);
}

.timeline-meta,
.followup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.timeline-date {
  font-size: 24rpx;
  color: var(--muted);
  text-align: right;
}

.timeline-title {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.timeline-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.review-tag.pending {
  background: rgba(160, 115, 72, 0.12);
  color: var(--muted);
}

.review-tag.partial {
  background: rgba(198, 136, 69, 0.16);
  color: var(--muted);
}

.review-tag.matched {
  background: rgba(108, 140, 101, 0.16);
  color: var(--muted);
}

.review-tag.unmet {
  background: rgba(114, 95, 84, 0.12);
  color: var(--muted);
}

.yao-hero {
  padding: 16rpx 4rpx 8rpx;
}
.form-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}
.optional-label {
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 400;
}
.quick-result-top {
  margin-top: 24rpx;
}
.quick-grid {
  gap: 0;
}
.quick-grid .formal-box {
  padding: 24rpx 0;
  border-radius: 0;
  background: transparent;
  border-bottom: 1rpx solid var(--border);
}
.quick-grid .formal-value {
  font-size: 30rpx;
}
.followup-head {
  align-items: flex-start;
  margin-top: 16rpx;
}
@media (prefers-reduced-motion: reduce) {
  .casting-line-row .hex-line-box {
    animation: none;
  }
}

/* style v2 uses button:not([size=mini]) { width: 184px }.
   Container + class selectors keep native buttons inside their layout cells. */
.selector-card .topic-grid,
.selector-card .guide-row,
.followup-card .review-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 20rpx;
}

.selector-card .topic-chip,
.selector-card .guide-chip,
.followup-card .review-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 48px;
  margin: 0;
  padding: 22rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  white-space: normal;
}

.selector-card .topic-chip:last-child:nth-child(odd) {
  grid-column: 1 / -1;
}

.selector-card .topic-chip.active,
.selector-card .guide-chip.active,
.followup-card .review-chip.active {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.selector-card .topic-chip.active::before,
.selector-card .guide-chip.active::before,
.followup-card .review-chip.active::before {
  content: "✓";
  flex-shrink: 0;
  margin-right: 10rpx;
  font-size: 24rpx;
}

.selector-card .chip-title,
.selector-card .guide-chip-title,
.selector-card .topic-chip.active .chip-title {
  min-width: 0;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
}

.selector-card .guide-chip {
  min-height: 44px;
  padding: 18rpx 12rpx;
  background: var(--soft);
  font-size: 26rpx;
}

.selector-stage + .selector-stage {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.question-box {
  width: 100%;
  height: 150rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: var(--soft);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.7;
}

.question-placeholder {
  color: var(--muted);
}

.question-counter {
  margin-top: 12rpx;
  color: var(--muted);
  text-align: right;
  font-size: 24rpx;
}

.cast-panel {
  margin-top: 24rpx;
}

.selector-card .cast-button,
.casting-card .skip-cast-button,
.quick-result-card .record-new-button,
.knowledge-card .knowledge-button,
.followup-card .review-note-edit {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 48px;
  margin-left: 0;
  margin-right: 0;
  box-sizing: border-box;
}

.selector-card .cast-button {
  min-height: 52px;
  font-size: 30rpx;
}

.selector-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  text-align: center;
}

.skip-cast-button,
.knowledge-button {
  margin-top: 24rpx;
}

.share-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.quick-result-card .share-button,
.poster-actions .poster-action,
.review-note-actions .primary-button,
.review-note-actions .secondary-button {
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 48px;
  margin: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
  box-sizing: border-box;
  white-space: normal;
}

.quick-result-card .record-new-button {
  margin-top: 20rpx;
}

.followup-card .review-row {
  margin-top: 24rpx;
}
